{
  "name": "bold",
  "label": "Bold & energetic",
  "fonts": [
    {"family": "InterTight", "weight": 900, "style": "normal", "file": "intertight-900.woff2"},
    {"family": "InterTight", "weight": 700, "style": "normal", "file": "intertight-700.woff2"}
  ],
  "caption": {"maxWords": 2, "case": "upper"},
  "hook": {"mode": "sequence"},
  "motion": {
    "hook": {"dur": 0.16, "ease": "back.out(3)", "from": {"opacity": 0, "scale": 1.6}, "to": {"opacity": 1, "scale": 1}},
    "hookOut": {"dur": 0.12, "ease": "power3.in"},
    "cap": {"dur": 0.12, "ease": "back.out(3)", "from": {"opacity": 0, "scale": 0.6}, "to": {"opacity": 1, "scale": 1}},
    "card": {"dur": 0.15, "ease": "power3.out", "from": {"opacity": 0, "y": -40}, "to": {"opacity": 1, "y": 0}},
    "item": {"dur": 0.18, "ease": "back.out(3.5)", "from": {"opacity": 0, "scale": 0.2}, "to": {"opacity": 1, "scale": 1}},
    "push": 1.0,
    "punch": 1.12
  }
}
